{
  "name": "cdv-judge",
  "displayName": "CDV — Judge for AI Coding Agents",
  "description": "CDV is the judge for AI coding agents — your agent said it works, CDV is the receipt. Conservative Dual-Verify loop monitor, git-stamped audit trail, and live prompt scoring for Cursor / Copilot / Claude Code.",
  "version": "1.0.0",
  "publisher": "loopllm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azank1/cdv",
    "directory": "vscode-loopllm"
  },
  "homepage": "https://github.com/azank1/cdv",
  "bugs": {
    "url": "https://github.com/azank1/cdv/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "verification",
    "judge",
    "scorer",
    "ai agent",
    "audit",
    "receipt",
    "cursor",
    "llm",
    "prompt",
    "quality",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cdv",
          "title": "CDV",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cdv": [
        {
          "type": "webview",
          "id": "cdv.promptLab",
          "name": "Prompt Lab"
        },
        {
          "type": "webview",
          "id": "cdv.loopMonitor",
          "name": "Loop Monitor"
        },
        {
          "type": "webview",
          "id": "cdv.dashboard",
          "name": "History"
        }
      ]
    },
    "commands": [
      {
        "command": "cdv.refreshStats",
        "title": "CDV: Refresh Prompt Stats"
      },
      {
        "command": "cdv.showDashboard",
        "title": "CDV: Show Dashboard"
      },
      {
        "command": "cdv.scoreSelection",
        "title": "CDV: Score Selected Text"
      }
    ],
    "keybindings": [
      {
        "command": "cdv.scoreSelection",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CDV",
      "properties": {
        "cdv.dbPath": {
          "type": "string",
          "default": "",
          "description": "Path to the cdv SQLite database. Leave empty to auto-resolve the per-project store via `cdv paths` (recommended)."
        },
        "cdv.pollIntervalMs": {
          "type": "number",
          "default": 3000,
          "description": "How often (ms) to poll the database for updates"
        },
        "cdv.statusFilePath": {
          "type": "string",
          "default": "",
          "description": "Path to status.json. Leave empty to auto-resolve alongside the per-project database."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
